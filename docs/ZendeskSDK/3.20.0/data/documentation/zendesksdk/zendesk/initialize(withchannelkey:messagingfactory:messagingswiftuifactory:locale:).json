 channel","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional parameter to include the "},{"code":"Messaging","type":"codeVoice"},{"type":"text","text":" UIKit capability, pass an initialized "},{"code":"DefaultMessagingFactory","type":"codeVoice"},{"type":"text","text":" here."}]}],"name":"messagingFactory"},{"name":"messagingSwiftUIFactory","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional parameter to include the "},{"code":"Messaging","type":"codeVoice"},{"text":" SwiftUI capability,","type":"text"},{"text":" ","type":"text"},{"text":"pass an initialized ","type":"text"},{"type":"codeVoice","code":"DefaultMessagingSwiftUIFactory"},{"type":"text","text":" here."}]}]},{"name":"locale","content":[{"inlineContent":[{"text":"Optional locale override (e.g. “en-US”) to use instead of the device’s language.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"An empty string or "},{"type":"codeVoice","code":"nil"},{"text":" uses the device’s language. The value is trimmed and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"canonicalized before use, so "},{"code":"\"EN\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"en\"","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\"En\""},{"type":"text","text":" are equivalent and "},{"code":"\"en_US\"","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"accepted as "},{"code":"\"en-US\"","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["    The locale is fixed for the lifetime of the returned instance. Passing a different `locale` for an","    already initialized `channelKey` has no effect - call `Zendesk.invalidate()` first, then `initialize`","    with the new locale.","","    Backend content — bot replies, settings and campaigns — follows this locale, as does the","    UIKit messaging interface (labels, buttons, error messages, VoiceOver descriptions, dates and","    plural forms). Lookup falls back from an exact match (`\"en-AU\"`) to the closest available","    translation (`\"en-GB\"`) and finally to the SDK's built-in English. Your app's own string","    overrides in `Bundle.main` continue to take precedence for the chosen locale.","","    Some things deliberately keep following the device: layout *direction*, Help Center article","    *content*, the Zendesk Voice SDK interface, and regional formatting (calendar, number separators,","    file-size units)."],"type":"codeListing"}]}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"This method must complete successfully before "},{"type":"codeVoice","code":"Zendesk.instance"},{"text":" can be called.","type":"text"},{"text":" ","type":"text"},{"text":"After a successful call has been made, calling it again with the same ","type":"text"},{"type":"codeVoice","code":"channelKey"},{"type":"text","text":" will succeed immediately"},{"type":"text","text":" "},{"type":"text","text":"without performing a network call."}],"type":"paragraph"}],"type":"aside","name":"Attention"}],"kind":"content"}],"abstract":[{"type":"text","text":"Initializes "},{"code":"Zendesk","type":"codeVoice"},{"type":"text","text":" for the given "},{"code":"channelKey","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"MessagingFactory","type":"codeVoice"},{"text":" for UIKit or ","type":"text"},{"code":"MessagingSwiftUIFactory","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for SwiftUI can be optionally passed here to add the ","type":"text"},{"code":"Messaging","type":"codeVoice"},{"text":" capability. This method is an asynchronous call","type":"text"},{"text":" ","type":"text"},{"text":"that retrieves settings from the network that calls the ","type":"text"},{"code":"completionHandler","type":"codeVoice"},{"text":" with the result.","type":"text"}],"references":{"doc://com.zendesk.Zendesk/documentation/ZendeskSDK/MessagingSwiftUIFactory":{"kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MessagingSwiftUIFactory","kind":"identifier"}],"url":"\/documentation\/zendesksdk\/messagingswiftuifactory","identifier":"doc:\/\/com.zendesk.Zendesk\/documentation\/ZendeskSDK\/MessagingSwiftUIFactory","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MessagingSwiftUIFactory"}],"title":"MessagingSwiftUIFactory","abstract":[]},"doc://com.zendesk.Zendesk/documentation/ZendeskSDK/Zendesk":{"kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Zendesk","kind":"identifier"}],"url":"\/documentation\/zendesksdk\/zendesk","identifier":"doc:\/\/com.zendesk.Zendesk\/documentation\/ZendeskSDK\/Zendesk","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Zendesk"}],"title":"Zendesk","abstract":[{"type":"text","text":"The entry point to execute SDK actions. To obtain an instance use "},{"type":"codeVoice","code":"Zendesk.initialize(channelKey:completionHandler:)"},{"type":"text","text":"."}]},"doc://com.zendesk.Zendesk/documentation/ZendeskSDK":{"title":"ZendeskSDK","identifier":"doc:\/\/com.zendesk.Zendesk\/documentation\/ZendeskSDK","abstract":[],"url":"\/documentation\/zendesksdk","role":"collection","type":"topic","kind":"symbol"},"doc://com.zendesk.Zendesk/documentation/ZendeskSDK/Zendesk/initialize(withChannelKey:messagingFactory:messagingSwiftUIFactory:locale:)":{"title":"initialize(withChannelKey:messagingFactory:messagingSwiftUIFactory:locale:)","identifier":"doc:\/\/com.zendesk.Zendesk\/documentation\/ZendeskSDK\/Zendesk\/initialize(withChannelKey:messagingFactory:messagingSwiftUIFactory:locale:)","abstract":[{"type":"text","text":"Initializes "},{"type":"codeVoice","code":"Zendesk"},{"type":"text","text