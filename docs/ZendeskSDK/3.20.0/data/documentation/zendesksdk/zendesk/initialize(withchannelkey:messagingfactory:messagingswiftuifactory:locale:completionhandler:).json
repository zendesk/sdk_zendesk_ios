, number separators,","    file-size units)."],"type":"codeListing","syntax":null}],"name":"locale"},{"name":"completionHandler","content":[{"type":"paragraph","inlineContent":[{"text":"A block that takes a ","type":"text"},{"code":"Result","type":"codeVoice"},{"text":" enum type. In the case of a success, a ","type":"text"},{"code":"Zendesk","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instance will be returned, in the case of a failure an ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" type.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method must complete successfully before "},{"type":"codeVoice","code":"Zendesk.instance"},{"type":"text","text":" can be called."},{"type":"text","text":" "},{"type":"text","text":"After a successful call has been made, calling it again with the same "},{"type":"codeVoice","code":"channelKey"},{"type":"text","text":" will succeed immediately"},{"type":"text","text":" "},{"type":"text","text":"without performing a network call."}]}],"style":"note","type":"aside","name":"Attention"}]}],"references":{"doc://com.zendesk.Zendesk/documentation/ZendeskSDK/Zendesk/initialize(withChannelKey:messagingFactory:messagingSwiftUIFactory:locale:completionHandler:)":{"title":"initialize(withChannelKey:messagingFactory:messagingSwiftUIFactory:locale:completionHandler:)","identifier":"doc:\/\/com.zendesk.Zendesk\/documentation\/ZendeskSDK\/Zendesk\/initialize(withChannelKey:messagingFactory:messagingSwiftUIFactory:locale:completionHandler:)","abstract":[{"text":"Initializes ","type":"text"},{"code":"Zendesk","type":"codeVoice"},{"text":" for the given ","type":"text"},{"code":"channelKey","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"MessagingFactory","type":"codeVoice"},{"text":" for UIKit or ","type":"text"},{"code":"MessagingSwiftUIFactor