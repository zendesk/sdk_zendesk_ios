nt*, the Zendesk Voice SDK interface, and regional formatting (calendar, number separators,","    file-size units)."]}]},{"name":"completionHandler","content":[{"inlineContent":[{"type":"text","text":"A block that takes a "},{"code":"Result","type":"codeVoice"},{"type":"text","text":" enum type. In the case of a success, a "},{"code":"Zendesk","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"instance will be returned, in the case of a failure an "},{"code":"Error","type":"codeVoice"},{"type":"text","text":" type."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"style":"note","type":"aside","name":"Attention","content":[{"inlineContent":[{"text":"This method must complete successfully before ","type":"text"},{"code":"Zendesk.instance","type":"codeVoice"},{"text":" can be called.","type":"text"},{"text":" ","type":"text"},{"text":"After a successful call has been made, calling it again with the same ","type":"text"},{"code":"channelKey","type":"codeVoice"},{"text":" will succeed immediately","type":"text"},{"text":" ","type":"text"},{"text":"without performing a network call.","type":"text"}],"type":"paragraph"}]}]}],"references":{"doc://com.zendesk.Zendesk/documentation/ZendeskSDK/Zendesk/initialize(withChannelKey:messagingFactory:messagingSwiftUIFactory:locale:completionHandler:)":{"abstract":[{"text":"Initializes ","type":"text"},{"code":"Zendesk","type":"codeVoice"},{"text":" for the given ","type":"text"},{"code":"channelKey","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"MessagingFactory","type":"codeVoice"},{"text":" for UIKit or ","type":"text"},{"code":"MessagingSwiftUIFactory","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for SwiftUI can be optionally passed here to add the ","type":"text"},{"code":"Messaging","type":"codeVoice"},{"text":" capability. This method is an asynchronous call","type":"text"},{"text":" ","type":"text"},{"text":