p Center article","    *content*, the Zendesk Voice SDK interface, and regional formatting (calendar, number separators,","    file-size units)."],"syntax":null,"type":"codeListing"}],"name":"locale"}]},{"content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"Zendesk"},{"type":"text","text":" instance will be returned."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"style":"note","content":[{"inlineContent":[{"text":"This method must complete successfully before ","type":"text"},{"code":"Zendesk.instance","type":"codeVoice"},{"text":" can be called.","type":"text"},{"text":" ","type":"text"},{"text":"After a successful call has been made, calling it again with the same ","type":"text"},{"code":"channelKey","type":"codeVoice"},{"text":" will succeed immediately","type":"text"},{"text":" ","type":"text"},{"text":"without performing a network call.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Attention"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This will throw an error of type "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" in case of failure."}]}],"style":"note","type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://com.zendesk.Zendesk/documentation/ZendeskSDK/Zendesk":{"kind":"symbol","identifier":"doc:\/\/com.zendesk.Zendesk\/documentation\/ZendeskSDK\/Zendesk","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Zendesk","kind":"identifier"}],"type":"topic","title":"Zendesk","role":"symbol","url":"\/documentation\/zendesksdk\/zendesk","navigatorTitle":[{"kind":"identifier","text":"Zendesk"}],"abstract":[{"type":"text","text":"The entry point to execute SDK actions. To obtain an instance use "},{"type":"codeVoice","code":"Zendesk.i