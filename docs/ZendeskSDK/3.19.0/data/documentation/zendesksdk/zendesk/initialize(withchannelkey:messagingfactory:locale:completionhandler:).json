{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.zendesk.Zendesk\/documentation\/ZendeskSDK\/Zendesk\/initialize(withChannelKey:messagingFactory:locale:completionHandler:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Initializes ","type":"text"},{"type":"codeVoice","code":"Zendesk"},{"type":"text","text":" for the given "},{"code":"channelKey","type":"codeVoice"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"MessagingFactory"},{"text":" can be optionally passed here","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to add the "},{"code":"Messaging","type":"codeVoice"},{"type":"text","text":" capability. This method is an asynchronous call"},{"type":"text","text":" "},{"type":"text","text":"that retrieves settings from the network that calls the "},{"type":"codeVoice","code":"completionHandler"},{"type":"text","text":" with the result."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"initialize","kind":"identifier"},{"kind":"text","text":"("},{"text":"withChannelKey","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"channelKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"messagingFactory"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.zendesk.Zendesk\/documentation\/ZendeskSDK\/MessagingFactory","kind":"typeIdentifier","preciseIdentifier":"c:@M@ZendeskSDK@objc(pl)MessagingFactory","text":"MessagingFactory"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"locale"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"? = nil, ","kind":"text"},{"text":"completionHandler","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping","ki